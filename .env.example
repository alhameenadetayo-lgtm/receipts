# Copy to .env and fill in. Never commit .env, and never paste these values into a chat.
# Sandbox app: developer.paypal.com > Apps & Credentials > Sandbox > your Merchant app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in after you register the webhook (spike/06-webhook.mjs register)
PAYPAL_WEBHOOK_ID=
# Backend (server.ts or Next.js): Postgres connection string and the public https address of the app
DATABASE_URL=
APP_URL=
# AI dispute defence. Without it those routes answer 503 and everything else still works.
ANTHROPIC_API_KEY=
